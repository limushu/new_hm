<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>NSMicrophoneUsageDescription</key>
    <string>用于在你主动开始录音或语音输入后录制音频，供你保存案件录音或将语音转成正文草稿。</string>
  <key>NSCalendarsUsageDescription</key>
  <string>用于将你选择的案笺日程添加到系统日历，并在改期或删除后维护对应副本；不会将其他个人日历内容导入案笺。</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>用于维护你主动关联的系统日历副本，包括改期和删除；不会将其他个人日历内容导入案笺。</string>
  <key>NSSpeechRecognitionUsageDescription</key>
    <string>用于在你主动转写后，在设备内将录音识别为可编辑的正文草稿或案件文字材料。</string>
</dict>
</plist>
